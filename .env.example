# Copy this file to .env and fill in your values. Never commit .env.

# General
LOG_LEVEL=INFO
SEED=42

# Paths
CORPUS_DIR=corpus
CHROMA_DIR=.chroma
MODEL_CACHE_DIR=.cache/fastembed

# Ingestion and retrieval
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
COLLECTION_NAME=veridane_policies
CHUNK_STRATEGY=heading
CHUNK_SIZE=350
CHUNK_OVERLAP=50
TOP_K=5

# LLM settings (used from Stage 3). Groq exposes an OpenAI-compatible API.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
JUDGE_MODEL=llama-3.3-70b-versatile

# Guardrails
MAX_QUESTION_CHARS=1000
MAX_ANSWER_WORDS=200
