# Copy this file to .env and fill in your values. Never commit .env.

# General
LOG_LEVEL=INFO
SEED=42

# Paths
CORPUS_DIR=corpus
CHROMA_DIR=.chroma

# Retrieval settings (used from Stage 2)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=400
CHUNK_OVERLAP=60
TOP_K=5

# LLM settings (used from Stage 3). Groq exposes an OpenAI-compatible API.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
JUDGE_MODEL=llama-3.3-70b-versatile

# Guardrails
MAX_QUESTION_CHARS=1000
MAX_ANSWER_WORDS=200
