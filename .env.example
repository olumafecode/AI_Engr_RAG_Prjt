# Copy this file to .env and fill in your values. Never commit .env.

# General
LOG_LEVEL=INFO
SEED=42
# Load the model and index when the server starts (render.yaml sets this to true)
WARMUP_ON_START=false

# Paths
CORPUS_DIR=corpus
CHROMA_DIR=.chroma
MODEL_CACHE_DIR=.cache/fastembed

# Ingestion
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# 0 lets ONNX Runtime choose; render.yaml uses 1 for the free instance's small CPU
EMBEDDING_THREADS=0
COLLECTION_NAME=veridane_policies
CHUNK_STRATEGY=heading
CHUNK_SIZE=350
CHUNK_OVERLAP=50

# Retrieval
TOP_K=5
RETRIEVAL_MODE=hybrid
CANDIDATE_POOL=30
RELEVANCE_THRESHOLD=0.55

# Generation. Groq exposes an OpenAI-compatible API.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
JUDGE_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
# complete (default) or concise, the wording used in the first evaluation run
ANSWER_STYLE=complete
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30

# Guardrails
MAX_QUESTION_CHARS=1000
MAX_ANSWER_WORDS=200
